class SemanticIntent:
    """Data class for semantic analysis results."""
    def __init__(self, intent_type: str, complexity: str, specialist_needed: str, confidence: float):
        self.intent_type = intent_type
        self.complexity = complexity
        self.specialist_needed = specialist_needed
        self.confidence = confidence
        
    def __repr__(self):
        return f"SemanticIntent(type={self.intent_type}, complexity={self.complexity}, specialist={self.specialist_needed}, confidence={self.confidence:.2f})"


class LlamaSemanticParser:
    """
    Llama 3.2-3B based semantic parser for intent classification.
    
    Analyzes user input to determine:
    - Intent type (conversation, file_operation, code_generation, complex_reasoning)
    - Complexity level (simple, medium, complex)
    - Specialist model needed (local_shortcuts, qwen_coder, cloud_api)
    """
    
    def __init__(self, model_path: str, debug_mode: bool = False):
        self.model_path = model_path
        self.debug_mode = debug_mode
        self._model = None
        self.chat_formatter = ChatTemplateFormatter(model_path, "Llama-3.2-3B")
        
        # Semantic analysis system prompt
        self.semantic_system_prompt = """You are a semantic parser for a coding assistant. Analyze user input and respond with ONLY a JSON object.

Classify the input into:
1. intent_type: "conversation", "file_operation", "code_generation", "complex_reasoning"
2. complexity: "simple", "medium", "complex" 
3. specialist_needed: "local_shortcuts", "qwen_coder", "cloud_api"
4. confidence: 0.0 to 1.0

Examples:
User: "hello" → {"intent_type": "conversation", "complexity": "simple", "specialist_needed": "local_shortcuts", "confidence": 0.9}
User: "pwd" → {"intent_type": "file_operation", "complexity": "simple", "specialist_needed": "local_shortcuts", "confidence": 0.95}
User: "create a Python script for sorting files" → {"intent_type": "code_generation", "complexity": "medium", "specialist_needed": "qwen_coder", "confidence": 0.85}
User: "design a microservices architecture" → {"intent_type": "complex_reasoning", "complexity": "complex", "specialist_needed": "cloud_api", "confidence": 0.8}

Respond with ONLY the JSON object, no other text."""
    
    @property
    def model(self) -> Llama:
        """Lazy load the semantic parser model."""
        if self._model is None:
            if self.debug_mode:
                console.print(f"[yellow]Loading Llama 3.2-3B semantic parser: {self.model_path}[/]")
            
            # Optimized config for semantic parsing (fast inference)
            semantic_config = {
                "n_ctx": 2048,          # Smaller context for fast parsing
                "n_batch": 256,         # Smaller batch for quick responses
                "n_threads": 4,         # Fewer threads for semantic parser
                "use_mmap": True,
                "use_mlock": False,
                "f16_kv": True,
                "n_gpu_layers": -1,     # Use Metal acceleration
                "verbose": False
            }
            
            try:
                self._model = Llama(model_path=self.model_path, **semantic_config)
                if self.debug_mode:
                    console.print(f"[green]✓ Semantic parser loaded (~3.3GB)[/]")
            except Exception as e:
                console.print(f"[red]✗ Failed to load semantic parser: {e}[/]")
                raise
        
        return self._model
    
    def parse_intent(self, user_input: str) -> SemanticIntent:
        """
        Parse user input to determine intent and routing.
        
        Args:
            user_input: Raw user input to analyze
            
        Returns:
            SemanticIntent with classification results
        """
        try:
            # Format prompt for semantic analysis
            prompt = self.chat_formatter.format_prompt(
                system_prompt=self.semantic_system_prompt,
                user_prompt=user_input
            )
            
            if self.debug_mode:
                console.print(f"[cyan]Semantic analysis prompt: {len(prompt)} chars[/]")
            
            # Generate semantic analysis (fast inference)
            start_time = time.time()
            response = self.model(
                prompt,
                max_tokens=200,         # Short response for JSON
                temperature=0.0,        # Deterministic classification
                top_p=0.9,
                stop=["}", "}\\n", "Human:", "User:"],
                echo=False
            )
            
            duration = time.time() - start_time
            
            # Extract response text
            if isinstance(response, dict) and "choices" in response:
                response_text = response["choices"][0]["text"]
            else:
                response_text = str(response)
            
            if self.debug_mode:
                console.print(f"[dim]Semantic analysis took {duration:.2f}s[/]")
                console.print(f"[dim]Raw semantic response: {response_text[:200]}[/]")
            
            # Parse JSON response
            try:
                # Clean up response text to extract JSON
                response_text = response_text.strip()
                if not response_text.startswith('{'):
                    # Find JSON in response
                    start_idx = response_text.find('{')
                    if start_idx != -1:
                        response_text = response_text[start_idx:]
                
                # Ensure JSON is complete
                if response_text.count('{') > response_text.count('}'):
                    response_text += '}'
                
                semantic_data = json.loads(response_text)
                
                return SemanticIntent(
                    intent_type=semantic_data.get("intent_type", "conversation"),
                    complexity=semantic_data.get("complexity", "simple"),
                    specialist_needed=semantic_data.get("specialist_needed", "local_shortcuts"),
                    confidence=semantic_data.get("confidence", 0.5)
                )
                
            except json.JSONDecodeError as e:
                if self.debug_mode:
                    console.print(f"[yellow]JSON parse error: {e}, falling back to heuristics[/]")
                
                # Fallback to heuristic classification
                return self._heuristic_classification(user_input)
        
        except Exception as e:
            if self.debug_mode:
                console.print(f"[red]Semantic parsing error: {e}, using fallback[/]")
            
            # Fallback to simple heuristics
            return self._heuristic_classification(user_input)
    
    def _heuristic_classification(self, user_input: str) -> SemanticIntent:
        """Fallback heuristic classification if LLM parsing fails."""
        user_lower = user_input.lower().strip()
        
        # Simple conversational patterns
        if any(greeting in user_lower for greeting in ["hello", "hi", "hey", "how are you"]):
            return SemanticIntent("conversation", "simple", "local_shortcuts", 0.8)
        
        # Direct commands
        if user_lower in ["pwd", "ls", "git status", "whoami"]:
            return SemanticIntent("file_operation", "simple", "local_shortcuts", 0.9)
        
        # Code creation keywords
        if any(keyword in user_lower for keyword in ["create", "write", "generate", "build"]):
            if any(code_word in user_lower for code_word in ["script", "function", "class", "code"]):
                return SemanticIntent("code_generation", "medium", "qwen_coder", 0.7)
        
        # Complex reasoning keywords
        if any(keyword in user_lower for keyword in ["architecture", "design", "strategy", "analyze"]):
            return SemanticIntent("complex_reasoning", "complex", "cloud_api", 0.6)
        
        # Default classification
        return SemanticIntent("conversation", "simple", "local_shortcuts", 0.5)


class DualModelHandler(CommandHandler):
    """
    Dual model handler for Phase 3 multi-agent coordination.
    
    Manages both models simultaneously:
    - Llama 3.2-3B: Semantic parser (always loaded, ~3.3GB)
    - Qwen2.5-Coder: Code specialist (loaded on-demand, ~1.8GB)
    
    Total memory usage: ~5.1GB (comfortable within 24GB limit)
    """
    
    def __init__(self, context: CommandContext, provider_name: str = "dual"):
        super().__init__(context)
        self.provider_name = provider_name
        self.debug_mode = context.debug_mode
        
        if not LLAMA_CPP_AVAILABLE:
            raise ImportError("llama-cpp-python is required for dual model handling")
        
        # Model paths
        self.semantic_parser_path = self._get_semantic_parser_path()
        self.code_specialist_path = self._get_code_specialist_path()
        
        # Initialize models
        self.semantic_parser = LlamaSemanticParser(
            self.semantic_parser_path, 
            self.debug_mode
        )
        self._code_specialist = None  # Lazy loaded
        
        # Supporting components
        self.prompt_builder = SimplifiedGGUFPromptBuilder()
        self.tool_parser = GGUFToolCallParser()
        self.context_manager = GGUFContextManager(provider_name)
        self.tool_executor = ToolExecutor(self.ctx)
        self.post_processor = GGUFResponsePostProcessor()
        
        # Configuration
        self.max_tool_iterations = 5
        
        # Initialize known tools
        available_tools = self._get_available_tools()
        tool_names = [tool["function"]["name"] for tool in available_tools]
        self.tool_parser.set_known_tools(tool_names)
        
        if self.debug_mode:
            console.print(f"[bold green]Initialized dual model handler[/]")
            console.print(f"[blue]Semantic parser: {self.semantic_parser_path.name}[/]")
            console.print(f"[blue]Code specialist: {self.code_specialist_path.name}[/]")
            console.print(f"[cyan]Expected memory usage: ~5.1GB total[/]")
    
    def _get_semantic_parser_path(self) -> Path:
        """Get path to Llama 3.2-3B semantic parser model."""
        cache_dir = Path(__file__).parent.parent / ".cache" / "deepcoderx" / "models"
        
        # Look for Llama 3.2-3B models
        llama_candidates = [
            "Llama-3.2-3B-Instruct-uncensored.Q4_K_S.gguf",
            "llama-3.2-3b-instruct.gguf",
            "Llama-3.2-3B-Instruct.gguf"
        ]
        
        for candidate in llama_candidates:
            model_path = cache_dir / candidate
            if model_path.exists():
                return model_path
        
        raise FileNotFoundError(f"Llama 3.2-3B semantic parser not found in {cache_dir}")
    
    def _get_code_specialist_path(self) -> Path:
        """Get path to Qwen2.5-Coder specialist model."""
        cache_dir = Path(__file__).parent.parent / ".cache" / "deepcoderx" / "models"
        
        # Look for Qwen models
        qwen_candidates = [
            "qwen2.5-coder-1.5b-instruct-q8_0.gguf",
            "qwen2.5-coder-1.5b-instruct-q4_k_s.gguf",
            "qwen2.5-coder-1.5b.gguf"
        ]
        
        for candidate in qwen_candidates:
            model_path = cache_dir / candidate
            if model_path.exists():
                return model_path
        
        raise FileNotFoundError(f"Qwen2.5-Coder specialist not found in {cache_dir}")
    
    @property
    def code_specialist(self) -> Llama:
        """Lazy load the code specialist model."""
        if self._code_specialist is None:
            if self.debug_mode:
                console.print(f"[yellow]Loading Qwen2.5-Coder specialist: {self.code_specialist_path.name}[/]")
            
            # Optimized config for code generation
            specialist_config = {
                "n_ctx": 4096,          # Full context for code tasks
                "n_batch": 512,         # Larger batch for code generation
                "n_threads": 6,         # More threads for complex generation
                "use_mmap": True,
                "use_mlock": False,
                "f16_kv": True,
                "n_gpu_layers": -1,     # Use Metal acceleration
                "verbose": False
            }
            
            try:
                self._code_specialist = Llama(
                    model_path=str(self.code_specialist_path), 
                    **specialist_config
                )
                if self.debug_mode:
                    console.print(f"[green]✓ Code specialist loaded (~1.8GB)[/]")
                    console.print(f"[cyan]Total memory usage: ~5.1GB[/]")
            except Exception as e:
                console.print(f"[red]✗ Failed to load code specialist: {e}[/]")
                raise
        
        return self._code_specialist
    
    def can_handle(self) -> bool:
        """Check if dual model handler should process this request."""
        user_input = self.ctx.user_input.lower()
        
        # Handle explicit dual model requests
        if user_input.startswith("@dual") or user_input.startswith("@semantic"):
            return True
        
        # Handle if this is the default provider
        if self.provider_name == config.DEFAULT_PROVIDER:
            # Check for other provider specifications
            for provider_name in config.PROVIDERS.keys():
                if provider_name != self.provider_name and user_input.startswith(f"@{provider_name}"):
                    return False
            return True
        
        return False
    
    def handle(self) -> None:
        """Main processing method with semantic parser coordination."""
        if self.debug_mode:
            console.print(f"[bold blue]🚀 Phase 3: Dual model processing[/]")
        
        # Step 1: Semantic analysis with Llama 3.2-3B
        self.ctx.status_message = "Analyzing intent with semantic parser..."
        semantic_intent = self.semantic_parser.parse_intent(self.ctx.user_input)
        
        if self.debug_mode:
            console.print(f"[cyan]Semantic analysis: {semantic_intent}[/]")
        
        # Add user message to context
        self.context_manager.add_user_message(self.ctx.user_input)
        
        # Step 2: Route to appropriate specialist based on semantic analysis
        if semantic_intent.specialist_needed == "local_shortcuts":
            self._handle_local_shortcuts(semantic_intent)
        elif semantic_intent.specialist_needed == "qwen_coder":
            self._handle_code_specialist(semantic_intent)
        elif semantic_intent.specialist_needed == "cloud_api":
            self._handle_cloud_routing(semantic_intent)
        else:
            # Fallback to conversational response
            self._handle_conversational(semantic_intent)
        
        # Save context after processing
        self.context_manager.save_session()
    
    def _handle_local_shortcuts(self, intent: SemanticIntent) -> None:
        """Handle simple commands with direct shortcuts."""
        if self.debug_mode:
            console.print(f"[green]🚀 Routing to local shortcuts[/]")
        
        user_input = self.ctx.user_input.lower().strip()
        
        # Direct command shortcuts (no model inference needed)
        direct_commands = {
            "pwd": "run_bash({\"command\": \"pwd\"})",
            "ls": "run_bash({\"command\": \"ls\"})",
            "git status": "run_bash({\"command\": \"git status\"})",
            "whoami": "run_bash({\"command\": \"whoami\"})"
        }
        
        if user_input in direct_commands:
            # Execute direct shortcut
            tool_call_str = f"<tool_call>{direct_commands[user_input]}</tool_call>"
            
            if self.debug_mode:
                console.print(f"[green]Direct shortcut: {tool_call_str}[/]")
            
            # Parse and execute
            tool_calls, _ = self.tool_parser.parse_and_execute_format(tool_call_str)
            if tool_calls:
                self._execute_tool_calls(tool_calls, tool_call_str)
            return
        
        # For other simple operations, use minimal prompting
        self._conversation_loop_with_specialist(None, intent)
    
    def _handle_code_specialist(self, intent: SemanticIntent) -> None:
        """Handle code generation with Qwen2.5-Coder specialist."""
        if self.debug_mode:
            console.print(f"[blue]🚀 Routing to Qwen2.5-Coder specialist[/]")
        
        # Load code specialist model
        specialist = self.code_specialist
        self._conversation_loop_with_specialist(specialist, intent)
    
    def _handle_cloud_routing(self, intent: SemanticIntent) -> None:
        """Handle complex reasoning by routing to cloud APIs."""
        if self.debug_mode:
            console.print(f"[magenta]🚀 Routing to cloud API for complex reasoning[/]")
        
        # For Phase 3 initial implementation, fallback to code specialist
        # In future iterations, this would route to DeepSeek/OpenAI
        self._handle_code_specialist(intent)
    
    def _handle_conversational(self, intent: SemanticIntent) -> None:
        """Handle conversational inputs with simple responses."""
        if self.debug_mode:
            console.print(f"[yellow]🚀 Generating conversational response[/]")
        
        # Use semantic parser for conversational responses (it's already loaded)
